# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# ---- Supabase (Milestone M0) ----
# Project Settings → Data API / API Keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Staff accounts ----
# Staff sign in with a username; Supabase Auth stores it as
# <username>@<domain>. This address never receives mail and the domain does not
# need to exist. Change it only before creating accounts — existing logins are
# keyed on the old value.
ADMIN_EMAIL_DOMAIN=nightcanteen.local

# ---- Weather accents (optional) ----
# The customer menu tints itself by time of day + live weather over campus.
# Defaults to Karjat / Vijaybhoomi. No API key needed (Open-Meteo).
# CAMPUS_LAT=18.9107
# CAMPUS_LON=73.3233

# ---- Razorpay (Milestone M3 — start in Test Mode) ----
# Dashboard → Settings → API Keys → Generate Test Key (starts with rzp_test_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed once deployed (public URL) — Dashboard → Settings → Webhooks.
RAZORPAY_WEBHOOK_SECRET=
